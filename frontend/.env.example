# Clerk publishable key (optional). When set, sign-in UI appears and API calls send Bearer tokens.
VITE_CLERK_PUBLISHABLE_KEY=

# Closed-beta passcode gate (Task 010). When set, AppGate overlay is shown until validated.
VITE_BETA_PASSCODE=

# BEN API base URL (optional). Defaults to production Railway URL.
# For local dev with vite proxy, use empty string or http://localhost:5173
VITE_BEN_API_BASE=

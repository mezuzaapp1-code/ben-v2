DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/ben
# Remote dev (Railway): cold connect can exceed 2s — pool warmup + these overrides help locally.
# BEN_DB_CONNECT_TIMEOUT_S=10
# BEN_DB_PING_TIMEOUT_S=4.5
# BEN_DB_OPERATION_TIMEOUT_S=10
# Server-side org for unsigned requests (never trust client JSON for tenancy).
BEN_ANONYMOUS_ORG_ID=00000000-0000-0000-0000-000000000001
# Closed-beta passcode gate (Task 010) — set both for local beta cohort.
BEN_LOCAL_BETA_MODE=false
BEN_BETA_PASSCODE=ENFORCE_AUTH=false
AUTH_SHADOW_MODE=true
CLERK_SECRET_KEY=sk_test_...
OPENAI_API_KEY=sk-...
# Optional API dispatch overrides (when unset, BEN maps frontier ids to known-good API models):
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_REASONING_API_MODEL=gpt-4o
# GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4.8
GOOGLE_API_KEY=...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_PRO=price_...
# Workspace Files -> Chat Context budgets (Gate 3D: rank files, then clip).
# BEN_WORKSPACE_FILES_CONTEXT_MAX_CHARS=12000
# BEN_WORKSPACE_FILES_PER_FILE_MAX_CHARS=2000
# Gate 4A chunk FTS (fail-safe OFF). ON still requires a workspace UUID allowlist.
# Empty BEN_WORKSPACE_CHUNK_RETRIEVAL_WORKSPACE_IDS does not enable globally.
# BEN_WORKSPACE_CHUNK_RETRIEVAL=off
# BEN_WORKSPACE_CHUNK_RETRIEVAL_WORKSPACE_IDS=
# Ready-text indexer (Gate 2). Fail-closed; never a global backfill.
# BEN_WORKSPACE_READY_TEXT_INDEX_WORKSPACE_IDS=
